<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Allows swipe-down anywhere on the home screen to pull down notifications -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Subtle tactile haptics and upper timer completion vibration -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Open system Clock / Alarms when tapping the dual clock -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Android 11+ (API 30+) package visibility for discovering launchable apps and stock Home launcher -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SixSlotLauncher">

        <!-- Primary Launcher Activity (always visible in normal phone launcher so you can re-enter anytime) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Dedicated Home Role Alias:
            Separating CATEGORY_HOME into an activity-alias allows the "Exit Launcher" button
            to cleanly step down from the default Home role in one tap and launch your phone's
            normal stock launcher immediately without trapping you in a Home loop.
        -->
        <activity-alias
            android:name=".HomeLauncherAlias"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
